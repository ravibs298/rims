# Copy to backend/.env for local (non-Docker) development.
NODE_ENV=development
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=rims
DB_PASSWORD=rims_dev_password
DB_NAME=rims
# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173
# Dev seed password for seeded users (never used in production; seed refuses to run there)
SEED_PASSWORD=ChangeMe-2026-dev
# Integration credentials are referenced by NAME from integration_configs.secret_ref.
# Names must start with INTEGRATION_. Example:
# INTEGRATION_ERP_TOKEN=...
